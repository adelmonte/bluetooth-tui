# Maintainer: adelmonte
pkgname=bluetooth-tui
pkgver=0.2.0
pkgrel=1
pkgdesc='A modern terminal UI for Bluetooth (BlueZ)'
arch=('x86_64')
url='https://github.com/adelmonte/bluetooth-tui'
license=('GPL-3.0-or-later')
depends=('dbus' 'bluez' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('bluez-utils: bluetoothctl')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2429be22e82f37929b89f48f8c052a47ecd36f3205f17a7f6cbd31b6d9f23e52')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/${CARGO_BUILD_TARGET:-.}/release/bluetooth-tui "$pkgdir/usr/bin/bluetooth-tui"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

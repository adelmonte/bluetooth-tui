# Maintainer: adelmonte
pkgname=bluetooth-tui
pkgver=0.1.0
pkgrel=1
pkgdesc='A modern terminal UI for Bluetooth (BlueZ)'
arch=('x86_64')
url='https://github.com/adelmonte/bluetooth-tui'
license=('GPL-3.0-or-later')
depends=('dbus' 'bluez' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('bluez-utils: bluetoothctl')
source=("$pkgname::git+file://$(realpath "$startdir/..")")
sha256sums=('SKIP')
options=('!lto')

pkgver() {
  cd "$pkgname"
  printf '%s.r%s.g%s' "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/bluetooth-tui "$pkgdir/usr/bin/bluetooth-tui"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
